# Allow tag/branch refs for Generality Labs' reusable workflows (they are pinned
# to a moving major tag on purpose); still require full commit-SHA pins for
# third-party actions.
rules:
  unpinned-uses:
    config:
      policies:
        "Generality-Labs/*": ref-pin
        "*": hash-pin
{% if use_claude_review %}
  # claude-review.yaml is copied from inspect_evals, which skips the same three
  # audits for it. Every other audit runs on it.

  # The workflow runs on pull_request_target and issue_comment so it can review
  # pull requests from forks and answer /review comments. It checks out the pull
  # request head without persisted credentials, restores claude-setup from the
  # workflow branch before using it, and gives Claude read tools plus Write.
  # Review this entry whenever the triggers or the checkout change.
  dangerous-triggers:
    ignore:
      - claude-review.yaml
  # The Bedrock role ARN is a repository secret. Moving it into a GitHub
  # environment needs that environment set up in each generated repo.
  secrets-outside-env:
    ignore:
      - claude-review.yaml
  # zizmor wants `uses: $/...` for local actions; actionlint 1.7.12 rejects that
  # form (rhysd/actionlint#711).
  self-repository:
    ignore:
      - claude-review.yaml
{% endif %}
