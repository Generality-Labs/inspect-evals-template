{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(make check:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run inspect:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run basedpyright:*)",
      "Bash(uv run inspect-evals-lint:*)",
      "Bash(uv run inspect-evals-readmes:*)",
      "Bash(make test:*)"
    ],
    "deny": [
      "Bash(git push origin main)"
    ],
    "ask": [
      "Bash(rm:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "generality": {
      "source": {
        "source": "github",
        "repo": "Generality-Labs/agent-skills",
        "ref": "v1.0.0"
      }
    }
  },
  "enabledPlugins": {
    "inspect-evals@generality": true
  }
}
